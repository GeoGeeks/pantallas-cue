<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de la aplicación IIS "cue-2026-agenda"
  (https://geoapps.esri.co/cue-2026-agenda/).

  Requiere en el servidor (una sola vez, a nivel de servidor):
    - Módulo "URL Rewrite" instalado.
    - Módulo "Application Request Routing" (ARR) instalado, con el proxy
      habilitado: IIS Manager > nodo del servidor > Application Request
      Routing Cache > "Server Proxy Settings..." > check "Enable proxy".
    - El proxy de la API (carpeta /server) corriendo como servicio de
      Windows vía NSSM en 127.0.0.1:3001 (ver README.md).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Reenvía las llamadas a la API hacia el servicio Node local (NSSM) -->
        <rule name="Agenda API reverse proxy" stopProcessing="true">
          <match url="^api/agenda/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/agenda/{R:1}" />
        </rule>

        <!-- SPA fallback: cualquier ruta que no sea un archivo/carpeta real
             ni empiece por api/agenda se resuelve con index.html -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/?api/agenda" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 🔴 Cada tipo de archivo que sirva el sitio necesita su `mimeMap`: IIS no
         entrega lo que no reconoce. Y falla de la peor forma — devuelve la página
         404 de Esri Colombia **con HTTP 200**, así que el archivo parece existir.
         Medido el 2026-09-01 en producción: los dos fondos `.webp` daban 200 con
         8 KB de HTML porque `.webp` no estaba declarado aquí. Se distingue del
         "archivo que no existe" porque ése cae en el fallback del SPA y devuelve
         `index.html` (538 B).
         ⚠️ Al añadir un formato nuevo al proyecto (`.webp`, `.avif`, `.woff2`…),
         hay que declararlo aquí ANTES de desplegar. -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
